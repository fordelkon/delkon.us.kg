---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
	nested?: boolean;
}

const {
	heading: { children, depth, slug, text },
	nested = false,
} = Astro.props;
---

<li class={`${depth > 2 ? "ms-2" : ""}`}>
	<a
		class:list={["post-disclosure-link relative line-clamp-2 ps-3", { "mt-2": depth > 2 }]}
		href={`#${slug}`}
	>
		<span
			aria-hidden="true"
			class:list={[
				"absolute start-0 top-[0.55em] size-1.5 rounded-full border border-printer-ink",
				{ "bg-printer-ink": !nested },
			]}
		></span>
		{text}
	</a>
	{!!children.length && (
		<ol>
			{children.map((subheading) => (
				<Astro.self heading={subheading} nested />
			))}
		</ol>
	)}
</li>
