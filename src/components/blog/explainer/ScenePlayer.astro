---
import Diagram from "./Diagram.astro";
import { renderScene } from "./mermaid";
import type { Scene } from "./scenes/types";

interface Props {
	scene: Scene;
	sceneId: string;
	study?: boolean;
}

const { scene, sceneId, study = false } = Astro.props;
const { caption, description } = scene;
const svgs = scene.diagram ? renderScene(sceneId, scene) : undefined;
const staticSvgs = study && scene.diagram ? renderScene(`${sceneId}-static`, scene) : undefined;
const stepDurationMs = 3000;
const frames = scene.frames.map((frame, index) => ({ ...frame, delayMs: index * stepDurationMs }));
---

<figure
	class:list={[
		"step-explainer not-prose",
		{ "study-explainer": study, "has-mermaid": Boolean(svgs) },
	]}
	data-scene={sceneId}
	aria-label={scene.title}
	data-pagefind-ignore
>
	{study && <p class="explainer-assumptions">{description}</p>}
	{svgs && <p class="explainer-assumptions">图较宽时可横向滚动，键盘聚焦后可用方向键。</p>}
	<step-explainer class="step-explainer-canvas" style={`--step-frame-duration: ${stepDurationMs}ms`}>
		<button
			class="step-explainer-toggle"
			type="button"
			aria-label="播放 原理演示"
			title="播放"
			hidden
		>
			<svg
				class="step-explainer-play"
				width="14"
				height="14"
				viewBox="0 0 16 16"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 2.5v11l9-5.5z" />
			</svg>
			<svg
				class="step-explainer-pause"
				width="14"
				height="14"
				viewBox="0 0 16 16"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 3h3v10H4zM10 3h3v10h-3z" />
			</svg>
		</button>
		<div
			class="step-explainer-visual"
			role="img"
			aria-label={description}
			tabindex={svgs ? 0 : undefined}
		>
			{frames.map((frame, index) => (
				<div
					class="step-explainer-frame"
					style={`animation-delay: ${frame.delayMs}ms`}
					aria-hidden="true"
				>
					{svgs ? (
						<div class="explainer-mermaid mermaid-diagram" set:html={svgs[index]} />
					) : (
						<Diagram
							frame={frame}
							marker={`${sceneId}-arrow-${index}`}
							height={scene.diagramHeight}
						/>
					)}
					{!svgs && (
						<p class="explainer-note">
							{study && (
								<span class="explainer-step">
									{index + 1} / {frames.length} ·{" "}
								</span>
							)}
							{frame.note}
						</p>
					)}
				</div>
			))}
		</div>
		{svgs && (
			<div class="explainer-mermaid-notes" aria-hidden="true">
				{frames.map((frame, index) => (
					<div
						class="step-explainer-frame"
						style={`animation-delay: ${frame.delayMs}ms`}
					>
						<p class="explainer-note">
							{study && (
								<span class="explainer-step">
									{index + 1} / {frames.length} ·{" "}
								</span>
							)}
							{frame.note}
						</p>
					</div>
				))}
			</div>
		)}
	</step-explainer>
	<figcaption>
		<p class="step-explainer-caption">{caption}</p>
		{scene.section && (
			<p class="explainer-reading">
				<a href={`#${scene.section}`}>阅读正文：{scene.title} →</a>
			</p>
		)}
		<details class="step-explainer-transcript">
			<summary>{study ? "查看全部静态图与步骤" : "查看文字步骤"}</summary>
			<ol>
				{frames.map((frame, index) => (
					<li>
						{study &&
							(staticSvgs ? (
								<div
									class="explainer-static-viewport"
									role="region"
									tabindex="0"
									aria-label={`${scene.title}，步骤 ${index + 1}，宽图可横向滚动`}
								>
									<div
										class="explainer-mermaid mermaid-diagram"
										aria-hidden="true"
										set:html={staticSvgs[index]}
									/>
								</div>
							) : (
								<Diagram
									frame={frame}
									marker={`${sceneId}-static-${index}`}
									height={scene.diagramHeight}
								/>
							))}
						<p>{frame.note}</p>
					</li>
				))}
			</ol>
		</details>
	</figcaption>
</figure>

<script>
	import "./playback";
</script>

<style is:global>
	@import "./styles.css";
</style>
