---
import { DIAGRAM_HEIGHT, DIAGRAM_WIDTH, type Frame, NODE_HEIGHT } from "./scenes/types";

interface Props {
	frame: Frame;
	marker: string;
	id?: string | undefined;
	height?: number | undefined;
}

const { frame, marker, id, height = DIAGRAM_HEIGHT } = Astro.props;
---

<svg
	class="explainer-diagram"
	viewBox={`0 0 ${DIAGRAM_WIDTH} ${height}`}
	aria-hidden="true"
	focusable="false"
>
	{frame.edges?.some((line) => !line.undirected) && <defs>
		<marker
			id={marker}
			viewBox="0 0 8 8"
			refX="7"
			refY="4"
			markerWidth="6"
			markerHeight="6"
			orient="auto-start-reverse"
		>
			<path d="M0 0 L8 4 L0 8z" fill="context-stroke" />
		</marker>
	</defs>}
	<g id={id}>
		{frame.edges?.map((line) => (
			<path
				class:list={["explainer-edge", { "is-active": line.active }]}
				d={line.path}
				stroke-dasharray={line.dashed ? "3 3" : undefined}
				marker-end={line.undirected ? undefined : `url(#${marker})`}
			/>
		))}
		{frame.boxes.map((node) => {
			const height = node.height ?? NODE_HEIGHT;
			return (
				<g
					data-glyph={node.glyph}
					class:list={["explainer-node", { "is-active": node.active, "is-muted": node.muted }]}
				>
					{node.glyph !== "label" && (
						<rect
							x={node.x}
							y={node.y}
							width={node.width}
							height={height}
							rx={node.glyph === "circle" ? height / 2 : undefined}
						/>
					)}
					{node.lines.map((line, index) => (
						<text
							x={node.x + node.width / 2}
							y={node.y + height / 2 + (index - (node.lines.length - 1) / 2) * 25}
							dominant-baseline="central"
							text-anchor="middle"
						>
							{line}
						</text>
					))}
				</g>
			);
		})}
	</g>
</svg>
