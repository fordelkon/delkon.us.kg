---
import ScenePlayer from "./ScenePlayer.astro";
import type { Scene } from "./scenes/types";

interface Props {
	scene: Scene;
	sceneId: string;
}

const { scene, sceneId } = Astro.props;
---

{scene.legend ? (
	<div class="explainer-scenes not-prose" data-pagefind-ignore>
		<p class="explainer-heading">{scene.title}</p>
		<p class="explainer-legend">
			{scene.legend}
			{scene.frames.length > 1 && (
				<>
					<br />
					粗边框标出当前状态；步骤停留时间不代表实际耗时。
				</>
			)}
		</p>
		<ScenePlayer scene={scene} sceneId={sceneId} study />
	</div>
) : (
	<ScenePlayer scene={scene} sceneId={sceneId} study />
)}
