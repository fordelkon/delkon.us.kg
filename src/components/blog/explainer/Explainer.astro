---
import ScenePlayer from "./ScenePlayer.astro";
import type { Scene } from "./scenes/types";

interface Props {
	scene: Scene;
	sceneId: string;
}

const { scene, sceneId } = Astro.props;
---

{scene.chapters ? (
    <explainer-scenes class="explainer-scenes not-prose" data-pagefind-ignore>
        <p class="explainer-heading">动态原理概览</p>
        <nav aria-label="选择原理场景" hidden>
            {scene.chapters.map((chapter, index) => (
                <button type="button" aria-controls={`${sceneId}-panel-${index}`} aria-pressed={index === 0}>
                    {index + 1}. {chapter.title}
                </button>
            ))}
        </nav>
        <p class="explainer-legend">{scene.legend ?? "蓝：发起方 · 橙：转发／处理 · 紫：协议／会话状态 · 绿：接收／结果"}{!scene.legend && <><br/>实线：数据交付 · 虚线：控制、查询或逻辑关系 · 双线框：连接端点</>}<br/>粗边框标出当前状态；步骤停留时间不代表实际耗时。</p>
        {scene.chapters.map((chapter, index) => (
            <section id={`${sceneId}-panel-${index}`} aria-label={chapter.title}>
                <h2 class="explainer-chapter-title">{chapter.title}</h2>
                <ScenePlayer scene={chapter} sceneId={`${sceneId}-${index}`} study />
            </section>
        ))}
    </explainer-scenes>
) : <ScenePlayer scene={scene} sceneId={sceneId} study />}

<script>
    import "./scenario-navigation";
</script>
