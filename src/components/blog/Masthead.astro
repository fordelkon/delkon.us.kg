---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import SeriesBadge from "@/components/SeriesBadge.astro";
import TagLinks from "@/components/TagLinks.astro";
import type { SeriesContext } from "@/data/series";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
	series?: SeriesContext | undefined;
}

const {
	content: { data },
	readingTime,
	series,
} = Astro.props;
---

{
	data.coverImage && (
		<div class="mb-8 aspect-video">
			<Image
				alt={data.coverImage.alt}
				layout="constrained"
				width={748}
				height={420}
				priority
				src={data.coverImage.src}
			/>
		</div>
	)
}
{data.draft ? <span class="text-base text-red-500">(Draft)</span> : null}
<h1 class="font-serif text-3xl leading-tight font-bold tracking-tight text-printer-ink sm:text-4xl">
	{data.title}
</h1>
<div
	class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 print-label text-printer-ink-light"
>
	<p class="tabular-nums">
		<FormattedDate date={data.publishDate} /> · {readingTime}
	</p>
	{series && <SeriesBadge series={series} />}
	{
		data.updatedDate && (
			<span class="rounded-sm border border-printer-ink/10 px-2 py-0.5 tabular-nums">
				Updated
				<FormattedDate class="ms-1" date={data.updatedDate} />
			</span>
		)
	}
</div>
<TagLinks tags={data.tags} indexed />
