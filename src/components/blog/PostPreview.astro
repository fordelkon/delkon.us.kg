---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { entryUrl, seriesUrl } from "@/data/routes";
import { getSeriesContext } from "@/data/series";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
	showSeries?: boolean;
};

const { as: Tag = "div", post, withDesc = false, showSeries = false } = Astro.props;
const series = showSeries ? await getSeriesContext(post) : undefined;
---

<div class:list={[withDesc && "py-(--receipt-row-padding)"]}>
	<a class:list={["receipt-row receipt-row-link", withDesc && "py-0"]} href={entryUrl(post)}>
		{!withDesc && <FormattedDate class="print-label text-printer-ink-light tabular-nums" date={post.data.publishDate} />}
		<Tag class="font-serif text-base leading-snug tracking-tight sm:text-lg">
			{post.data.draft && <span class="text-red-500">(Draft) </span>}
			{post.data.title}
		</Tag>
		{withDesc && (
			<p class="line-clamp-2 font-serif text-sm leading-relaxed text-printer-ink/80">
				{post.data.description}
			</p>
		)}
	</a>
	{(withDesc || series) && (
		<div class:list={["flex flex-wrap items-center gap-x-3", withDesc ? "mt-1" : "-mt-1 mb-1"]}>
			{withDesc && <FormattedDate class="receipt-meta" date={post.data.publishDate} />}
			{series && (
				<a class="receipt-section-link printer-link" href={seriesUrl(series.group.id)}>
					系列 · {series.group.title}
				</a>
			)}
		</div>
	)}
</div>
