---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { entryUrl, seriesUrl } from "@/data/routes";
import { getSeriesContext } from "@/data/series";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
	showSeries?: boolean;
};

const { as: Tag = "div", post, withDesc = false, showSeries = false } = Astro.props;
const series = showSeries ? await getSeriesContext(post) : undefined;
---

<div
	class="receipt-row group hover:bg-printer-ink/3 focus-within:bg-printer-ink/3"
>
	<FormattedDate
		class="print-label text-printer-ink-light tabular-nums"
		date={post.data.publishDate}
	/>
	<Tag
		class="font-serif text-base leading-snug tracking-tight text-printer-ink transition-colors group-hover:text-printer-accent sm:text-lg"
	>
		{post.data.draft && <span class="text-red-500">(Draft) </span>}
		<a
			class="rounded-xs outline-hidden focus-visible:ring-2 focus-visible:ring-printer-accent/40"
			href={entryUrl(post)}
		>
			{post.data.title}
		</a>
	</Tag>
	{series && <a class="w-fit print-label text-printer-ink-light hover:text-printer-accent" href={seriesUrl(series.group.id)}>{series.group.title}</a>}
	{
		withDesc && (
			<q class="line-clamp-2 font-serif text-xs leading-relaxed text-printer-ink-light">
				{post.data.description}
			</q>
		)
	}
</div>
