---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { entryUrl, seriesUrl } from "@/data/routes";
import { getSeriesContext } from "@/data/series";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
	showSeries?: boolean;
};

const { as: Tag = "div", post, withDesc = false, showSeries = false } = Astro.props;
const series = showSeries ? await getSeriesContext(post) : undefined;
---

<div>
	<a class="receipt-row receipt-row-link" href={entryUrl(post)}>
		<FormattedDate
			class="print-label text-printer-ink-light tabular-nums"
			date={post.data.publishDate}
		/>
		<Tag class="font-serif text-base leading-snug tracking-tight sm:text-lg">
			{post.data.draft && <span class="text-red-500">(Draft) </span>}
			{post.data.title}
		</Tag>
		{withDesc && (
			<q class="line-clamp-2 font-serif text-xs leading-relaxed text-printer-ink-light">
				{post.data.description}
			</q>
		)}
	</a>
	{series && (
		<a
			class="printer-link -mt-1 mb-1 inline-flex min-h-8 items-center rounded-xs px-1 text-xs text-printer-ink-light hover:text-printer-accent focus-visible:text-printer-accent focus-visible:outline-2 focus-visible:outline-printer-accent"
			href={seriesUrl(series.group.id)}
		>
			系列 · {series.group.title}
		</a>
	)}
</div>
