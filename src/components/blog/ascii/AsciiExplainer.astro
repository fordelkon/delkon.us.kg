---
import { getScene, type SceneId } from "./scenes/index";

interface Props {
	scene: SceneId;
}

const { scene: sceneId } = Astro.props;
const { caption, description, width, frames: sceneFrames } = getScene(sceneId);

function escapeHtml(text: string) {
	return text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

let elapsedMs = 0;

const frames = sceneFrames.map((frame) => {
	const html = frame.rows
		.map((row, index) => {
			if (frame.active.includes(index))
				return `<span class="ascii-explainer-active">${escapeHtml(row)}</span>\n`;

			let cursor = 0;
			let html = "";

			for (const mark of frame.emphasis.filter((span) => span.row === index)) {
				html += `${escapeHtml(row.slice(cursor, mark.start))}<span class="ascii-explainer-active">${escapeHtml(row.slice(mark.start, mark.end))}</span>`;
				cursor = mark.end;
			}

			return `${html}${escapeHtml(row.slice(cursor))}\n`;
		})
		.join("");

	const rendered = { html, delayMs: elapsedMs, durationMs: frame.durationMs };
	elapsedMs += frame.durationMs;

	return rendered;
});
---

<figure class="ascii-explainer not-prose" data-scene={sceneId} data-pagefind-ignore>
	<ascii-explainer class="ascii-explainer-canvas" style={`--ascii-columns: ${width}`}>
		<button
			class="ascii-explainer-toggle"
			type="button"
			aria-label="播放 ASCII 演示"
			title="播放"
			hidden
		>
			<svg
				class="ascii-explainer-play"
				width="14"
				height="14"
				viewBox="0 0 16 16"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 2.5v11l9-5.5z" />
			</svg>
			<svg
				class="ascii-explainer-pause"
				width="14"
				height="14"
				viewBox="0 0 16 16"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 3h3v10H4zM10 3h3v10h-3z" />
			</svg>
		</button>
		<div class="ascii-explainer-visual" role="img" aria-label={description}>
			{frames.map((frame) => <pre
				class="ascii-explainer-frame"
				style={`animation-delay: ${frame.delayMs}ms; --ascii-frame-duration: ${frame.durationMs}ms`}
				aria-hidden="true"
				set:html={frame.html}
			></pre>)}
		</div>
	</ascii-explainer>
	<figcaption class="ascii-explainer-caption">{caption}</figcaption>
</figure>

<script>
	import "./playback";
</script>

<style is:global>
	@import "./styles.css";
</style>
