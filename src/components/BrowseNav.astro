---
interface Props {
	current: "posts" | "series" | "tags";
}

const { current } = Astro.props;
const { pathname } = Astro.url;

const links = [
	{ id: "posts", href: "/posts/", title: "按时间" },
	{ id: "series", href: "/series/", title: "系列与单篇" },
	{ id: "tags", href: "/tags/", title: "按主题" },
];

const currentKind = pathname === `/${current}/` ? "page" : "location";
---
<nav
	aria-label="Browse writing"
	class="mt-3 mb-6 flex flex-wrap gap-x-5 border-b border-dashed border-printer-ink/20 font-mono text-sm"
>
	{links.map((link) => (
		<a
			class:list={[
				"inline-flex min-h-11 items-center border-b-2 px-1 hover:text-printer-accent focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-printer-accent",
				current === link.id
					? "border-printer-accent font-semibold text-printer-ink"
					: "border-transparent text-printer-ink-light",
			]}
			href={link.href}
			aria-current={current === link.id ? currentKind : undefined}
		>
			{link.title}
		</a>
	))}
</nav>
