---
import { Icon } from "astro-icon/components";

/**
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Installed packs: @iconify-json/mdi, @iconify-json/simple-icons
	(the X logo lives in simple-icons; MDI only has the old Twitter bird).
*/
const socialLinks: {
	friendlyName: string;
	isWebmention?: boolean;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/fordelkon",
		name: "mdi:github",
	},
	{
		friendlyName: "X",
		link: "https://x.com/fordelkon",
		name: "simple-icons:x",
	},
	{
		friendlyName: "Telegram",
		link: "https://t.me/fordelkon",
		name: "mdi:telegram",
	},
	{
		friendlyName: "Email",
		link: "mailto:2799388816@qq.com",
		name: "mdi:email",
	},
];
---

<div class="flex flex-wrap items-center gap-2">
	<ul class="flex flex-wrap items-center gap-2" role="list">
		{
			socialLinks.map(({ friendlyName, isWebmention, link, name }) => (
				<li class="flex">
					<a
						class="inline-flex items-center gap-1.5 rounded-sm border border-printer-ink/10 px-2.5 py-1 print-label text-printer-ink-light transition-colors hover:border-printer-accent/30 hover:text-printer-accent focus-visible:border-printer-accent/30 focus-visible:text-printer-accent"
						href={link}
						rel={`noreferrer ${isWebmention ? "me authn" : ""}`}
						target="_blank"
					>
						<Icon aria-hidden="true" class="h-3 w-3" focusable="false" name={name} />
						{friendlyName}
					</a>
				</li>
			))
		}
	</ul>
</div>
