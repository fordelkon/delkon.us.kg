---
import "@/styles/blocks/search.css";
---

<script>
	import type { PagefindModal } from "@pagefind/component-ui";

	(() => {
		if (import.meta.env.DEV) return;
		const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
		onIdle(async () => {
			const { getInstanceManager } = await import("@pagefind/component-ui");
			// Pagefind 1.5 reinitializes reconnected elements and wraps an existing
			// dialog again. Use fresh elements and a fresh registry for each page;
			// otherwise triggers retain detached modals after ClientRouter swaps.
			document.addEventListener("astro:before-swap", () => {
				for (const modal of document.querySelectorAll<PagefindModal>("pagefind-modal")) {
					modal.close();
				}

				getInstanceManager().removeInstance("site-search");
			});
		});
	})();
</script>

<pagefind-config
	instance="site-search"
	baseUrl={`${import.meta.env.BASE_URL}`}
	bundle-path={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`}></pagefind-config>
<pagefind-modal-trigger instance="site-search" id="search" class="ms-auto shrink-0" hide-shortcut compact></pagefind-modal-trigger>
<pagefind-modal instance="site-search"></pagefind-modal>
