---
import "@/styles/blocks/search.css";
---

<script>
	import type { PagefindModal, PagefindModalTrigger } from "@pagefind/component-ui";
	import dialogStyles from "@/styles/blocks/search-dialog.css?url";

	let pagefind: typeof import("@pagefind/component-ui") | undefined;
	let stylesheet: HTMLLinkElement | undefined;
	let stylesReady: Promise<void> | undefined;

	const viewport = window.visualViewport;
	const searchDialog = "pagefind-modal > dialog";
	const touchPrimary = matchMedia("(pointer: coarse)");
	let unlockSearchPage: (() => void) | undefined;

	function freezeSearchPage(dialog: HTMLDialogElement): void {
		if (!touchPrimary.matches || unlockSearchPage) return;

		const { body } = document;
		const { scrollX, scrollY } = window;

		const observer = new MutationObserver(() => {
			if (!dialog.open || !dialog.isConnected) unlock();
		});

		function unlock(): void {
			observer.disconnect();
			unlockSearchPage = undefined;
			delete body.dataset.searchScrollLocked;
			body.style.removeProperty("--search-page-top");
			window.scrollTo({ left: scrollX, top: scrollY, behavior: "instant" });
		}

		unlockSearchPage = unlock;
		body.style.setProperty("--search-page-top", `${-scrollY}px`);
		body.dataset.searchScrollLocked = "";
		observer.observe(dialog, { attributeFilter: ["open"] });

		// Pagefind can replace its internal dialog when updating its markup.
		if (dialog.parentElement) observer.observe(dialog.parentElement, { childList: true });
	}

	function fitSearchViewport(dialog: HTMLDialogElement): void {
		if (!viewport) return;

		// The on-screen keyboard can move and shrink the visual viewport without resizing the layout.
		dialog.style.setProperty("--search-viewport-top", `${viewport.offsetTop}px`);
		dialog.style.setProperty("--search-viewport-left", `${viewport.offsetLeft}px`);
		dialog.style.setProperty("--search-viewport-width", `${viewport.width}px`);
		dialog.style.setProperty("--search-viewport-height", `${viewport.height}px`);
	}

	const fitOpenSearch = () => {
		const dialog = document.querySelector<HTMLDialogElement>(`${searchDialog}:modal`);

		if (dialog) fitSearchViewport(dialog);
	};

	if (viewport) {
		viewport.addEventListener("resize", fitOpenSearch);
		viewport.addEventListener("scroll", fitOpenSearch);
	}

	document.addEventListener(
		"beforetoggle",
		(event) => {
			const dialog = event.target;

			if (!(dialog instanceof HTMLDialogElement) || !dialog.matches(searchDialog)) return;

			if (event.newState === "open") {
				fitSearchViewport(dialog);
				freezeSearchPage(dialog);
			} else {
				unlockSearchPage?.();
			}
		},
		true,
	);

	// Older mobile browsers don't dispatch beforetoggle on dialogs.
	document.addEventListener("focusin", (event) => {
		if (event.target instanceof Element) {
			const dialog = event.target.closest<HTMLDialogElement>(`${searchDialog}:modal`);

			if (dialog) freezeSearchPage(dialog);
		}
	});

	function loadDialogStyles() {
		return new Promise<void>((resolve, reject) => {
			const link = document.createElement("link");
			link.rel = "stylesheet";
			link.href = dialogStyles;
			link.addEventListener("load", () => resolve(), { once: true });
			link.addEventListener("error", () => {
				link.remove();
				stylesheet = undefined;
				reject(new Error("Could not load the search stylesheet."));
			}, { once: true });
			stylesheet = link;
			document.head.append(link);
		});
	}

	async function startSearch(trigger: PagefindModalTrigger, button: HTMLButtonElement) {
		if (button.hasAttribute("aria-busy")) return;

		const status = document.getElementById("search-load-status");
		button.setAttribute("aria-busy", "true");

		if (status) status.textContent = "Loading search…";

		try {
			await (stylesReady ??= loadDialogStyles());

			if (!trigger.isConnected) return;

			pagefind ??= await import("@pagefind/component-ui");

			// The upgrade replaces the initial button with Pagefind's own trigger.
			if (!trigger.isConnected) return;

			trigger.buttonEl?.focus({ preventScroll: true });
			trigger.openModal();

			if (status) status.textContent = "";
		} catch {
			if (!stylesheet) stylesReady = undefined;

			if (status) status.textContent = "Search could not load. Reload the page to try again.";
		} finally {
			button.removeAttribute("aria-busy");
		}
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) return;

		const button = event.target.closest<HTMLButtonElement>("button[data-search-start]");
		const trigger = button?.closest<PagefindModalTrigger>("pagefind-modal-trigger");

		if (button && trigger) void startSearch(trigger, button);
	});

	document.addEventListener("keydown", (event) => {
		if (event.defaultPrevented || event.isComposing || event.altKey || event.shiftKey) return;

		const isMac = /mac/i.test(navigator.userAgent);
		const usesShortcut = isMac ? event.metaKey && !event.ctrlKey : event.ctrlKey && !event.metaKey;

		if (!usesShortcut || event.key.toLowerCase() !== "k") return;

		const activeElement = document.activeElement;

		if (
			activeElement?.matches("input, textarea") ||
			(activeElement instanceof HTMLElement && activeElement.isContentEditable)
		) return;

		// Pagefind handles the shortcut itself once its trigger upgrades.
		const button = document.querySelector<HTMLButtonElement>("#search [data-search-start]");

		if (!button) return;

		event.preventDefault();
		button.click();
	});

	document.addEventListener("astro:before-swap", (event) => {
		// Keep the loaded link matched across Astro's head swaps.
		if (stylesheet) event.newDocument.head.append(stylesheet.cloneNode());

		if (!pagefind) return;

		// Fresh elements and registry entries keep triggers from finding detached dialogs.
		document.querySelector<PagefindModal>("pagefind-modal")?.close();
		unlockSearchPage?.();
		pagefind.getInstanceManager().removeInstance("site-search");
	});
</script>

<pagefind-config
	instance="site-search"
	baseUrl={`${import.meta.env.BASE_URL}`}
	bundle-path={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`}></pagefind-config>
<pagefind-modal-trigger instance="site-search" id="search" class="ms-auto shrink-0" hide-shortcut compact>
	<button
		aria-haspopup="dialog"
		aria-keyshortcuts="Control+K Meta+K"
		aria-label="Search"
		class="pf-trigger-btn"
		data-search-start
		type="button"
	>
		<span aria-hidden="true" class="pf-trigger-icon"></span>
	</button>
</pagefind-modal-trigger>
<span class="sr-only" id="search-load-status" role="status"></span>
<pagefind-modal instance="site-search"></pagefind-modal>
