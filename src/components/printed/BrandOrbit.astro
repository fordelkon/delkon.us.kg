---
// Keep a useful static contour before the animation controller connects.
const staticPath = `${Array.from({ length: 121 }, (_, index) => {
	const t = (index / 120) * Math.PI * 2;
	const x = 50 + 34 * Math.cos(t) - 5 * Math.cos(5 * t);
	const y = 50 + 34 * Math.sin(t) - 5 * Math.sin(5 * t);

	return `${index ? "L" : "M"}${x.toFixed(3)},${y.toFixed(3)}`;
}).join(" ")} Z`;
---

<brand-orbit aria-hidden="true">
	<svg viewBox="0 0 100 100" fill="none" focusable="false">
		<g>
			<path d={staticPath} stroke="currentColor" stroke-width="1.7" opacity="0.22" />
			<g data-orbit-particles>
				{Array.from({ length: 62 }, () => (
					<circle fill="currentColor" r="0" />
				))}
			</g>
		</g>
	</svg>
</brand-orbit>

<style>
	brand-orbit {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 72px;
		height: 72px;
		transform: translate(-50%, -50%);
		pointer-events: none;
		color: color-mix(in oklab, var(--color-printer-ink) 72%, var(--color-printer-body));
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	// Thinking Five: use the same point function and clock for contour and
	// particles. Adapt the radii to leave room for the stationary 32px badge.
	// Reference: https://paidax01.github.io/math-curve-loaders/
	class BrandOrbit extends HTMLElement {
		connectedCallback() {
			const group = this.querySelector("g");
			const path = this.querySelector("path");
			const trail = this.querySelector("[data-orbit-particles]");
			const particles = [...this.querySelectorAll("circle")];

			if (!group || !path || !trail) return;

			const initialPath = path.getAttribute("d") ?? "";
			const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
			let frame = 0;
			let elapsed = 0;
			let previous = 0;
			// Limit the decoration to eight seconds of visible playback. Background
			// time does not consume the budget; a finished orbit never restarts.
			const playbackDuration = 8000;

			const point = (progress: number, amplitude: number): [number, number] => {
				const t = progress * Math.PI * 2;

				return [
					50 + 34 * Math.cos(t) - amplitude * Math.cos(5 * t),
					50 + 34 * Math.sin(t) - amplitude * Math.sin(5 * t),
				];
			};

			// The 72px decoration needs no display-rate updates. Cache geometry and
			// invariant particle attributes; only positions change during a frame.
			const contourSamples = Array.from(
				{ length: 121 },
				(_, index): [number, number, number, number] => {
					const t = (index / 120) * Math.PI * 2;

					return [34 * Math.cos(t), 34 * Math.sin(t), Math.cos(5 * t), Math.sin(5 * t)];
				},
			);

			particles.forEach((particle, index) => {
				const fade = (1 - index / (particles.length - 1)) ** 0.56;
				particle.setAttribute("r", (0.45 + fade * 2.2).toFixed(3));
				particle.setAttribute("opacity", (0.04 + fade * 0.96).toFixed(3));
			});

			const render = (now: number) => {
				frame = requestAnimationFrame(render);

				if (previous && now - previous < 1000 / 30 - 0.5) return;

				elapsed += previous ? now - previous : 0;
				previous = now;

				if (elapsed >= playbackDuration) {
					cancelAnimationFrame(frame);
					trail.setAttribute("opacity", "0");

					return;
				}

				// Fade the particles during the final 600ms, leaving the current
				// contour in place so completion does not snap to another shape.
				if (elapsed > playbackDuration - 600) {
					trail.setAttribute("opacity", String((playbackDuration - elapsed) / 600));
				}

				const amplitude = 7 * (0.76 + 0.24 * Math.sin((elapsed / 4200) * Math.PI * 2 + 0.55));

				const contour = contourSamples.map(([baseX, baseY, detailX, detailY], index) => {
					const x = 50 + baseX - amplitude * detailX;
					const y = 50 + baseY - amplitude * detailY;

					return `${index ? "L" : "M"}${x.toFixed(3)},${y.toFixed(3)}`;
				});

				path.setAttribute("d", `${contour.join(" ")} Z`);
				group.setAttribute("transform", `rotate(${-(elapsed / 28000) * 360} 50 50)`);

				particles.forEach((particle, index) => {
					const tail = index / (particles.length - 1);
					const [x, y] = point(elapsed / 4600 - tail * 0.38, amplitude);
					particle.setAttribute("cx", x.toFixed(3));
					particle.setAttribute("cy", y.toFixed(3));
				});
			};

			const sync = () => {
				cancelAnimationFrame(frame);
				previous = 0;

				if (elapsed >= playbackDuration) return;

				particles.forEach((particle) => {
					particle.style.display = reducedMotion.matches ? "none" : "";
				});

				if (reducedMotion.matches) {
					group.removeAttribute("transform");
					path.setAttribute("d", initialPath);
				}

				if (!reducedMotion.matches && !document.hidden) {
					frame = requestAnimationFrame(render);
				}
			};

			reducedMotion.addEventListener("change", sync);
			document.addEventListener("visibilitychange", sync);
			this.cleanup = () => {
				cancelAnimationFrame(frame);
				reducedMotion.removeEventListener("change", sync);
				document.removeEventListener("visibilitychange", sync);
			};

			sync();
		}

		private cleanup?: () => void;

		disconnectedCallback() {
			this.cleanup?.();
		}
	}

	if (!customElements.get("brand-orbit")) {
		customElements.define("brand-orbit", BrandOrbit);
	}
</script>
