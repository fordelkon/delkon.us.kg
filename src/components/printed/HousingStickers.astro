---
const stickers = [
	{ id: "chatgpt", label: "ChatGPT", tilt: -8, offset: 2 },
	{ id: "claude", label: "Claude", tilt: 5, offset: -2 },
	{ id: "zai", label: "Zai", tilt: -3, offset: 1 },
];
---

<housing-stickers>
	{
		stickers.map(({ id, label, tilt, offset }) => (
			<button
				aria-hidden="true"
				aria-label={`Move ${label} sticker with the arrow keys; Escape resets it`}
				data-sticker-id={id}
				disabled
				style={`--sticker-image-small: url('/stickers/${id}-small.webp'); --sticker-image-compact: url('/stickers/${id}-compact.webp'); --sticker-image-full: url('/stickers/${id}.webp'); --sticker-tilt: ${tilt}deg; --sticker-offset: ${offset}px`}
				title={`Drag ${label} around the printer`}
				type="button"
			/>
		))
	}
</housing-stickers>

<script>
	import { bindHousingDrag } from "./housing-sticker-drag";

	class HousingStickers extends HTMLElement {
		private cleanup: (() => void) | undefined;

		connectedCallback(): void {
			this.cleanup?.();
			this.cleanup = bindHousingDrag(this);
		}

		disconnectedCallback(): void {
			this.cleanup?.();
		}
	}

	if (!customElements.get("housing-stickers")) {
		customElements.define("housing-stickers", HousingStickers);
	}
</script>

<style>
	housing-stickers {
		display: none;
		pointer-events: none;
	}

	@media (min-width: 24rem) {
		housing-stickers {
			--sticker-height: 1.625rem;
			position: relative;
			display: flex;
			align-self: center;
			align-items: center;
			gap: 0.125rem;
			margin-inline: auto 0.375rem;
			/* Let the brand determine the row height, not the tallest decal. */
			block-size: 0;
		}

		housing-stickers button {
			position: relative;
			flex: none;
			block-size: var(--sticker-height);
			aspect-ratio: 2 / 3;
			background: var(--sticker-image-compact) center / contain no-repeat;
			transform: translate(var(--drag-x, 0px), calc(var(--sticker-offset) + var(--drag-y, 0px)))
				rotate(var(--sticker-tilt));
			filter: drop-shadow(0 1px 1px rgb(0 0 0 / 18%));
			user-select: none;
		}

		housing-stickers button:enabled {
			cursor: grab;
			pointer-events: auto;
			touch-action: none;
		}

		housing-stickers button:focus-visible {
			outline: 2px solid var(--color-printer-accent);
			outline-offset: 2px;
		}

		housing-stickers button[data-moving] {
			cursor: grabbing;
			filter: drop-shadow(0 4px 5px rgb(0 0 0 / 32%));
		}
	}

	@media (min-width: 26rem) {
		housing-stickers {
			--sticker-height: 2rem;
			gap: 0.1875rem;
			margin-inline-end: 0.75rem;
		}
	}

	@media (min-width: 40rem) {
		housing-stickers {
			--sticker-height: 3.5rem;
			gap: 0.625rem;
			padding-inline: 0.5rem;
			margin-inline-end: 1.25rem;
		}
	}

	/* The 66px artwork covers the 32px mobile decal at 2x and the 56px desktop decal at 1x. */
	@media (width < 40rem) and (max-resolution: 2dppx), (min-width: 40rem) and (max-resolution: 1dppx) {
		housing-stickers button {
			background-image: var(--sticker-image-small);
		}
	}

	@media (min-width: 40rem) and (min-resolution: 1.5dppx) {
		housing-stickers button {
			background-image: var(--sticker-image-full);
		}
	}
</style>
