---
import siteIconUrl from "@/icons/icon.svg?url";
import { siteConfig } from "@/site.config";
import BrandOrbit from "./BrandOrbit.astro";

// Offset the decorative LED pulse using the static page's build time, so the
// housing's LED does not start every page at the same pulse phase.
const indicatorDelay = `-${Date.now() % 2000}ms`;
---

<!-- Sticky print head: the housing stays pinned to the viewport while the
     paper scrolls beneath it, so scrolling down reads as the printer
     retracting the sheet back through the feed slit. The paper output area
     sits at a lower z-index (see Base.astro) to slide under this housing. -->
<header
	class:list={[
		"group printer-header-border relative overflow-hidden rounded-t-[2.5rem] rounded-b-sm bg-printer-body",
	]}
	id="main-header"
>
	<div class="relative px-(--receipt-content-inset) pt-6 pb-5 sm:pt-10">
		<!-- Brand plate -->
		<div class="relative mb-8 flex items-start justify-between">
			<div class="flex items-center gap-4">
				<div class="brand-avatar relative">
					{siteConfig.showLogo && <BrandOrbit />}
					<a
						aria-current={Astro.url.pathname === "/" ? "page" : false}
						aria-label={siteConfig.title}
						class="relative z-10 ml-2 block h-8 w-8 overflow-hidden rounded-full bg-printer-paper shadow-sm ring-1 ring-black/10 dark:ring-white/15"
						href="/"
					>
						<img alt="" class="h-full w-full object-cover" decoding="sync" src={siteIconUrl} />
					</a>
				</div>
				<div>
					<div class="font-mono text-sm font-bold tracking-[0.25em] text-printer-ink uppercase">
						{siteConfig.title}
					</div>
					<div class="mt-0.5 font-mono text-[9px] tracking-[0.1em] text-printer-ink-light uppercase">
						{siteConfig.description}
					</div>
				</div>
			</div>
			<!-- ON indicator light -->
			<div class="flex flex-col items-center gap-1.5" aria-hidden="true">
				<div class="relative flex h-3.5 w-3.5 items-center justify-center rounded-full bg-black/10 dark:bg-black/40">
					<div
						class="printer-led h-2.5 w-2.5 rounded-full"
						style={`animation-delay: ${indicatorDelay}`}
					></div>
					<div class="pointer-events-none absolute inset-0 rounded-full border border-black/10 shadow-inner dark:border-white/5"></div>
				</div>
				<span class="font-mono text-[8px] leading-none tracking-widest text-printer-ink-light uppercase">
					ON
				</span>
			</div>
		</div>

		<!-- The site's nav and control rows are composed by Header.astro and
		     slot in here, between the brand plate and the feed slit. -->
		<slot />
	</div>

	<!-- The housing's bottom cutout exposes the scrolling sheet directly,
	     so no stationary strip can separate from the paper at the feed slot. -->
	<div class="bg-printer-shell relative flex h-5 items-center justify-center">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 shadow-[inset_0_2px_4px_rgba(0,0,0,0.08)]"
		></div>
		<div
			aria-hidden="true"
			class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-black/5 to-transparent"
		></div>
		<div
			aria-hidden="true"
			class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-black/5 to-transparent"
		></div>
		<div
			aria-hidden="true"
			class="absolute left-2 right-2 h-[6px] rounded-[1px] bg-black/60 shadow-[inset_0_1px_3px_rgba(0,0,0,0.8)] sm:left-8 sm:right-8"
		></div>
	</div>
</header>

<style>
	.brand-avatar {
		flex: 0 0 3rem;
		width: 3rem;
		height: 2rem;
	}

	.brand-avatar a:focus-visible {
		outline: 2px solid var(--color-printer-accent);
		outline-offset: 3px;
	}

	/* Cut the paper opening out of the housing while retaining its outer
	   shadow. The opening shares the paper's responsive horizontal inset
	   (--paper-inset, defined in printer-housing.css) so it aligns with
	   PaperViewport's margin. */
	header {
		clip-path: polygon(
			-60px -60px,
			calc(100% + 60px) -60px,
			calc(100% + 60px) 100%,
			calc(100% - var(--paper-inset)) 100%,
			calc(100% - var(--paper-inset)) calc(100% - 12px),
			var(--paper-inset) calc(100% - 12px),
			var(--paper-inset) 100%,
			-60px 100%
		);
	}
</style>
