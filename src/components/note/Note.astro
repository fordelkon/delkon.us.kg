---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import SeriesBadge from "@/components/SeriesBadge.astro";
import TagLinks from "@/components/TagLinks.astro";
import { entryUrl } from "@/data/routes";
import type { SeriesContext } from "@/data/series";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
	isPreview?: boolean | undefined;
	/** Row mode: title and timestamp only, matching PostPreview's listing rows. */
	compact?: boolean | undefined;
	/** Series context, shown as a badge on detail pages only. */
	series?: SeriesContext | undefined;
};

const { as: Tag = "div", note, isPreview = false, compact = false, series } = Astro.props;
const isLinkedRow = isPreview && compact;
const Container = isLinkedRow ? "a" : "article";
---

<Container
	class:list={[
		isPreview && "receipt-row",
		isLinkedRow && "receipt-row-link",
		isPreview && !compact && "group hover:bg-printer-ink/3 focus-within:bg-printer-ink/3",
	]}
	data-pagefind-body={isPreview ? undefined : true}
	href={isLinkedRow ? entryUrl(note) : undefined}
>
	<Tag
		class:list={[
			"font-serif leading-snug tracking-tight",
			isPreview ? "text-base sm:text-lg" : "text-2xl font-bold text-printer-ink sm:text-3xl",
			isPreview && !compact && "text-printer-ink transition-colors group-hover:text-printer-accent",
		]}
	>
		{
			isPreview && !compact ? (
				<a
					class="rounded-xs outline-hidden focus-visible:ring-2 focus-visible:ring-printer-accent/40"
					href={entryUrl(note)}
				>
					{note.data.title}
				</a>
			) : (
				<>{note.data.title}</>
			)
		}
	</Tag>
	<FormattedDate
		class="print-label text-printer-ink-light tabular-nums"
		dateTimeOptions={{
			hour: "2-digit",
			minute: "2-digit",
			year: "2-digit",
			month: "2-digit",
			day: "2-digit",
		}}
		date={note.data.publishDate}
	/>
	{!isPreview && series && (
		<div class="mt-3 print-label text-printer-ink-light">
			<SeriesBadge series={series} />
		</div>
	)}
	{!isPreview && <TagLinks tags={note.data.tags} indexed />}
	{!compact && (
		<div
			class="prose prose-sm mt-3 max-w-none font-serif sm:prose-base [&_table]:block [&_table]:overflow-x-auto"
			class:list={{ "line-clamp-6": isPreview }}
		>
			<slot />
		</div>
	)}
</Container>
