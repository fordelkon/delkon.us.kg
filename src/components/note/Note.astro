---
import { type CollectionEntry, render } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { entryUrl } from "@/data/routes";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
	isPreview?: boolean | undefined;
};

const { as: Tag = "div", note, isPreview = false } = Astro.props;
const { Content } = await render(note);
---

<article
	class:list={[
		isPreview &&
			"group -mx-2 flex flex-col gap-1 rounded-md px-2 py-2.5 transition-colors hover:bg-printer-ink/3 focus-within:bg-printer-ink/3",
	]}
	data-pagefind-body={isPreview ? false : true}
>
	<Tag
		class:list={[
			"font-serif leading-snug tracking-tight text-printer-ink transition-colors",
			isPreview
				? "text-base group-hover:text-printer-accent sm:text-lg"
				: "text-2xl font-bold sm:text-3xl",
		]}
	>
		{
			isPreview ? (
				<a
					class="rounded-xs outline-hidden focus-visible:ring-2 focus-visible:ring-printer-accent/40"
					href={entryUrl(note)}
				>
					{note.data.title}
				</a>
			) : (
				<>{note.data.title}</>
			)
		}
	</Tag>
	<FormattedDate
		class="print-label text-printer-ink-light tabular-nums"
		dateTimeOptions={{
			hour: "2-digit",
			minute: "2-digit",
			year: "2-digit",
			month: "2-digit",
			day: "2-digit",
		}}
		date={note.data.publishDate}
	/>
	<div
		class="prose prose-sm mt-3 max-w-none font-serif sm:prose-base [&_table]:block [&_table]:overflow-x-auto"
		class:list={{ "line-clamp-6": isPreview }}
	>
		<Content />
	</div>
</article>
