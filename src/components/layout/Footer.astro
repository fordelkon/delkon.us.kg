---
import { menuLinks, siteConfig } from "@/site.config";

interface Props {
	showStamp?: boolean;
}

const { showStamp = false } = Astro.props;
const year = new Date().getFullYear();
const printDate = new Date().toISOString().slice(0, 10);
const domain = new URL(siteConfig.url).hostname;
---

<footer
	class="relative z-10 mt-4 border-t border-dashed border-printer-ink/10 px-(--receipt-content-inset) py-6 print-label text-printer-ink-light"
>
	<div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
		<div class="print-label">
			&copy; {siteConfig.author}&nbsp;{year}
		</div>
		<nav
			aria-label="Footer"
			class="flex items-center gap-4 print-label"
		>
			{
				menuLinks.map((link) => (
					<a class="transition-colors hover:text-printer-accent" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	{
		showStamp && (
			<div class="mt-8 flex items-center justify-between border-t border-dotted border-printer-ink/10 pt-4">
				<span>Printed on {printDate}</span>
				<span>{domain}</span>
			</div>
		)
	}
</footer>
