---
import MobileNav from "@/components/layout/MobileNav.astro";
import PrinterHousing from "@/components/printed/PrinterHousing.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";
---

<!-- Composition root for the printer housing: PrinterHousing owns the
     brand plate, LED, feed slit, and clip-path; MobileNav owns the burger
     toggle; this file renders the nav links and composes the control
     cluster. -->
<PrinterHousing>
	<!-- Navigation row -->
	<div class="relative mt-2 flex flex-col items-stretch gap-1.5 sm:flex-row sm:items-center sm:gap-2">
		<nav
			aria-label="Main"
			class="order-2 hidden flex-col gap-1.5 pt-3 group-[.menu-open]:flex sm:order-none sm:flex sm:flex-1 sm:flex-row sm:items-center sm:gap-1 sm:p-0"
			id="navigation-menu"
		>
			{menuLinks.map((link) => (
				<a
					aria-current={Astro.url.pathname === link.path ? "page" : false}
					class="printer-btn whitespace-nowrap"
					href={link.path}
				>
					<span class="leading-none">{link.title}</span>
				</a>
			))}
		</nav>
		<div class="flex shrink-0 items-center justify-end gap-2">
			<Search />
			<!-- size="cluster": uniform 40px touch target at mobile widths and
			     no extra start margin, matching the burger beside it. -->
			<ThemeToggle size="cluster" />
			<MobileNav />
		</div>
	</div>
</PrinterHousing>
