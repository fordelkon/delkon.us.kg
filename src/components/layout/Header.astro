---
import PrinterHousing from "@/components/printed/PrinterHousing.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";
---

<PrinterHousing>
	<div class="relative mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
		<nav
			aria-label="Main"
			class="flex flex-auto flex-wrap items-center gap-1"
		>
			{menuLinks.map((link) => (
				<a
					aria-current={Astro.url.pathname === link.path ? "page" : false}
					class="printer-btn grow whitespace-nowrap sm:grow-0"
					data-sticker-obstacle
					href={link.path}
				>
					<span class="leading-none">{link.title}</span>
				</a>
			))}
		</nav>
		<div class="ms-auto flex shrink-0 items-center gap-1 sm:gap-2" data-sticker-obstacle>
			{import.meta.env.PROD && <Search />}
			<ThemeToggle size="cluster" />
		</div>
	</div>
</PrinterHousing>
