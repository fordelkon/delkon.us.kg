---
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-10 flex items-center justify-between gap-4 border-t border-dashed border-printer-ink/10 pt-4 print-label">
			{prevUrl && (
				<a
					class="text-printer-ink-light transition-colors hover:text-printer-accent focus-visible:text-printer-accent"
					href={prevUrl.url}
				>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "Previous"}
				</a>
			)}
			{nextUrl && (
				<a
					class="text-printer-ink-light transition-colors hover:text-printer-accent focus-visible:text-printer-accent"
					href={nextUrl.url}
				>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "Next"}
				</a>
			)}
		</nav>
	)
}
