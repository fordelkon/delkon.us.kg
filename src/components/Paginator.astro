---
import type { Page } from "astro";

interface Props {
	page: Pick<Page, "url">;
	labels?: { next: string; prev: string };
}

const {
	page: {
		url: { next, prev },
	},
	labels = { next: "Next Page →", prev: "← Previous Page" },
} = Astro.props;
---

{
	(prev || next) && (
		<nav class="mt-10 flex items-center justify-between gap-4 border-t border-dashed border-printer-ink/10 pt-4 print-label">
			{prev && (
				<a
					class="text-printer-ink-light transition-colors hover:text-printer-accent focus-visible:text-printer-accent"
					href={prev}
				>
					{labels.prev}
				</a>
			)}
			{next && (
				<a
					class="text-printer-ink-light transition-colors hover:text-printer-accent focus-visible:text-printer-accent"
					href={next}
				>
					{labels.next}
				</a>
			)}
		</nav>
	)
}
