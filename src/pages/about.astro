---
import AboutIdentity from "@/components/about/AboutIdentity.astro";
import EducationRecords, { type EducationRecord } from "@/components/about/EducationRecords.astro";
import SkillInventory, { type Skill } from "@/components/about/SkillInventory.astro";
import PrintedDivider from "@/components/printed/PrintedDivider.astro";
import PrintedSection from "@/components/printed/PrintedSection.astro";
import PageLayout from "@/layouts/Base.astro";

const education: EducationRecord[] = [
	{
		period: "2025.09 – 2028.06",
		school: "西安电子科技大学",
		degree: "硕士",
		academy: "人工智能学院",
		major: "计算机科学与技术专业",
		status: "在读",
	},
	{
		period: "2021.09 – 2025.06",
		school: "西安电子科技大学",
		degree: "本科",
		academy: "人工智能学院",
		major: "人工智能专业",
	},
];

const skills: Skill[] = [
	{ name: "Python", level: 4 },
	{ name: "TypeScript", level: 4 },
	{ name: "React", level: 4 },
	{ name: "Node.js", level: 3 },
	{ name: "Git", level: 3 },
	{ name: "Linux", level: 3 },
	{ name: "C++", level: 2 },
	{ name: "Rust", level: 2 },
];

const meta = {
	description: "delkon 的个人介绍、教育背景与常用工具。",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="font-serif text-2xl font-bold tracking-tight sm:text-3xl">About delkon</h1>
	<div class="mt-6">
		<AboutIdentity
			quote="You can outsource your thinking, but you cannot outsource your understanding…"
		/>
	</div>

	<PrintedDivider style="dotted" />

	<section>
		<PrintedSection label="Education" />
		<h2 class="sr-only">Education</h2>
		<EducationRecords records={education} />
	</section>

	<PrintedDivider style="dashed" />

	<section>
		<PrintedSection label="Tools I use" />
		<h2 class="sr-only">Tools I use</h2>
		<SkillInventory skills={skills} />
	</section>

	<PrintedDivider style="dashed" />

	<p class="prose prose-sm max-w-none font-serif sm:prose-base">
		在这里记录学习、写代码和使用工具时遇到的小问题。想持续阅读，可以订阅
		<a href="/rss.xml">文章 RSS</a> 和 <a href="/notes/rss.xml">便签 RSS</a>。
	</p>
</PageLayout>
