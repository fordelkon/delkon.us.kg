---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import BrowseNav from "@/components/BrowseNav.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import PrintedSection from "@/components/printed/PrintedSection.astro";
import { getPublishedPosts } from "@/data/entries";
import { getPinnedPosts, groupPostsByYear, MAX_POSTS_PER_PAGE } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const publishedPosts = await getPublishedPosts();

	return paginate(publishedPosts, {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { pinnedPosts: getPinnedPosts(publishedPosts) },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	pinnedPosts: CollectionEntry<"post">[];
}

const { page, pinnedPosts } = Astro.props;

const meta = {
	description: "Browse all posts by publication date.",
	title: "Posts",
};

const groupedByYear = groupPostsByYear(page.data);
---

<PageLayout meta={meta}>
	<header class="flex items-center gap-3">
		<h1 class="receipt-title">Posts</h1>
		<a class="text-printer-accent hover:text-printer-ink" href="/rss.xml" target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:rss" />
		</a>
	</header>
	<BrowseNav current="posts" />
	{page.currentPage === 1 && pinnedPosts.length > 0 && (
		<section class="mb-(--receipt-section-gap)" aria-label="Pinned posts">
			<PrintedSection label="Pinned" />
			<ul role="list">
				{pinnedPosts.map((post) => (
					<li>
						<PostPreview showSeries as="h2" post={post} />
					</li>
				))}
			</ul>
		</section>
	)}
	{groupedByYear.map(([yearKey, posts]) => (
		<section class="mb-(--receipt-section-gap)" aria-labelledby={`year-${yearKey}`}>
			<h2 id={`year-${yearKey}`} class="mb-(--receipt-heading-gap) print-label-wide text-printer-ink-light">
				<span class="sr-only">Posts in </span>
				{yearKey}
			</h2>
			<ul class="divide-y divide-dotted divide-printer-ink/10" role="list">
				{posts.map((post) => (
					<li>
						<PostPreview showSeries as="h3" post={post} withDesc />
					</li>
				))}
			</ul>
		</section>
	))}
	<Pagination page={page} />
</PageLayout>
