---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "This page could not be found.",
	title: "404 | Page not found",
};
---

<PageLayout meta={meta}>
	<section class="not-found" aria-labelledby="not-found-title">
		<div class="ascii-not-found" aria-hidden="true" />
		<p class="print-label-wide text-printer-ink-light">
			Error 404 · Page feed empty
		</p>
		<h1 id="not-found-title" class="receipt-title mt-3">
			这一页没有从打印机里出来
		</h1>
		<p class="mt-4 font-serif text-sm leading-relaxed text-printer-ink/80">
			Requested page not found. 请检查地址，或从 <a class="printer-link" href="/">首页</a> 重新出发。
		</p>
	</section>
</PageLayout>

<style>
	/* Centre the printed message as one group within the paper's content area. */
	.not-found {
		display: flex;
		min-block-size: clamp(20rem, 45svh, 28rem);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
</style>
