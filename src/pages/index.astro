---
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import PrintedDivider from "@/components/printed/PrintedDivider.astro";
import PrintedSection from "@/components/printed/PrintedSection.astro";
import SeriesArchive from "@/components/SeriesArchive.astro";
import SocialList from "@/components/SocialList.astro";
import WorksGrid from "@/components/work/WorksGrid.astro";
import { getStandaloneNotes, getStandalonePosts } from "@/data/entries";
import { getPinnedPosts } from "@/data/post";
import { getSeriesGroups } from "@/data/series";
import { works } from "@/data/works";
import PageLayout from "@/layouts/Base.astro";

// Posts
const MAX_POSTS = 5;
const standalonePosts = await getStandalonePosts();
const latestPosts = standalonePosts.slice(0, MAX_POSTS);

// Series members surface through their series page, not the home page.
const pinnedPosts = getPinnedPosts(standalonePosts);

// Notes, set to a max of 4
const MAX_NOTES = 4;
const latestNotes = (await getStandaloneNotes()).slice(0, MAX_NOTES);

// Folder rows give series a single home-page entry point per collection.
const [postSeriesGroups, noteSeriesGroups] = await Promise.all([
	getSeriesGroups("post"),
	getSeriesGroups("note"),
]);

const meta = { title: "Home" };
---

<PageLayout meta={meta}>
	<section>
		<h1 class="receipt-title text-printer-ink">
			delkon
		</h1>
		<p class="mt-2 max-w-prose font-serif text-[13px] leading-relaxed text-printer-ink-light">
			西安电子科技大学人工智能学院在读硕士。这里是一台「热敏打印机」，打印我关于技术与生活的文章与便签。更多
			<a class="printer-link" href="/about/">
				关于我
			</a>
			。
		</p>
		<div class="mt-4">
			<SocialList />
		</div>
	</section>

	<PrintedDivider style="dotted" />

	<section>
		<PrintedSection label="Works" />
		<WorksGrid records={works} />
	</section>

	<PrintedDivider style="dashed" />

	<section>
		<PrintedSection label="Posts">
			<a
				class="print-label text-printer-accent transition-colors hover:text-printer-ink focus-visible:text-printer-ink"
				href="/posts/"
			>
				View all →
			</a>
		</PrintedSection>
		<SeriesArchive groups={postSeriesGroups} />
		{pinnedPosts.length > 0 && (
			<section class="mb-(--receipt-group-gap)">
				<h2 class="sr-only">Pinned posts</h2>
				<ul role="list" class="space-y-1">
					{pinnedPosts.map((p) => (
						<li>
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)}
		<ul role="list" class="space-y-1">
			{latestPosts.map((p) => (
				<li>
					<PostPreview post={p} />
				</li>
			))}
		</ul>
	</section>

	<PrintedDivider style="dashed" />

	<section>
		<PrintedSection label="Notes">
			<a
				class="print-label text-printer-accent transition-colors hover:text-printer-ink focus-visible:text-printer-ink"
				href="/notes/"
			>
				View all →
			</a>
		</PrintedSection>
		<SeriesArchive groups={noteSeriesGroups} />
		<ul role="list" class="space-y-1">
			{latestNotes.map((note) => (
				<li>
					<Note note={note} as="h2" isPreview compact />
				</li>
			))}
		</ul>
	</section>
</PageLayout>
