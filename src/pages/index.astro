---
import EntryList from "@/components/EntryList.astro";
import PrintedDivider from "@/components/printed/PrintedDivider.astro";
import SocialList from "@/components/SocialList.astro";
import WorksGrid from "@/components/work/WorksGrid.astro";
import { getPublishedNotes, getPublishedPosts } from "@/data/entries";
import { getPinnedPosts } from "@/data/post";
import { works } from "@/data/works";
import PageLayout from "@/layouts/Base.astro";

// Posts
const MAX_POSTS = 5;
const publishedPosts = await getPublishedPosts();

// Series membership does not hide entries from the chronological flow.
const pinnedPosts = getPinnedPosts(publishedPosts);

const latestPosts = publishedPosts
	.filter((post) => !pinnedPosts.includes(post))
	.slice(0, MAX_POSTS);

// Notes, set to a max of 4
const MAX_NOTES = 4;
const latestNotes = (await getPublishedNotes()).slice(0, MAX_NOTES);

const meta = { title: "Home" };
---

<PageLayout meta={meta}>
	<section>
		<h1 class="receipt-title text-printer-ink">
			delkon
		</h1>
		<p class="mt-2 max-w-prose font-serif text-[13px] leading-relaxed text-printer-ink-light">
			西安电子科技大学人工智能学院在读硕士。这里是一台「热敏打印机」，打印我关于技术与生活的文章与便签。更多
			<a class="printer-link" href="/about/">
				关于我
			</a>
			。
		</p>
		<div class="mt-4">
			<SocialList />
		</div>
	</section>

	<PrintedDivider style="dotted" />

	<section aria-labelledby="latest-posts">
		<header class="receipt-section-header">
			<h2 id="latest-posts" class="receipt-section-title">近期文章</h2>
			<a class="receipt-section-link" href="/posts/">全部文章 →</a>
		</header>
		{pinnedPosts.length > 0 && (
			<div class="mb-(--receipt-group-gap)">
				<h3 class="mb-1 print-label text-printer-ink-light">置顶</h3>
				<EntryList entries={pinnedPosts} />
			</div>
		)}
		<EntryList entries={latestPosts} />
		<a class="receipt-section-link mt-(--receipt-group-gap)" href="/series/">系列与单篇 →</a>
	</section>

	<PrintedDivider />

	<section aria-labelledby="works">
		<h2 id="works" class="receipt-section-title mb-(--receipt-heading-gap)">作品</h2>
		<WorksGrid records={works} />
	</section>

	<PrintedDivider />

	<section aria-labelledby="latest-notes">
		<header class="receipt-section-header">
			<h2 id="latest-notes" class="receipt-section-title">便签</h2>
			<a class="receipt-section-link" href="/notes/">全部便签 →</a>
		</header>
		<EntryList entries={latestNotes} />
	</section>
</PageLayout>
