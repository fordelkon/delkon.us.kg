---
import { type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import SeriesArchive from "@/components/SeriesArchive.astro";
import { getStandaloneNotes } from "@/data/entries";
import { getSeriesGroups, type SeriesGroup } from "@/data/series";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_NOTES_PER_PAGE = 10;
	const standaloneNotes = await getStandaloneNotes();

	// Folders scoped to notes: only series with note members become folders.
	const seriesGroups = await getSeriesGroups("note");

	return paginate(standaloneNotes, {
		pageSize: MAX_NOTES_PER_PAGE,
		props: { seriesGroups },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
	seriesGroups: SeriesGroup[];
}

const { page, seriesGroups } = Astro.props;

const meta = {
	description: "Read my collection of notes",
	title: "Notes",
};
---

<PageLayout meta={meta}>
	<header class="mb-8 flex items-center gap-3">
		<h1 class="font-serif text-2xl font-bold tracking-tight sm:text-3xl">Notes</h1>
		<a class="text-printer-accent hover:text-printer-ink" href="/notes/rss.xml" target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:rss" />
		</a>
	</header>
	{page.currentPage === 1 && <SeriesArchive groups={seriesGroups} />}
	{page.data.length > 0 && (
		<ul class="divide-y divide-dotted divide-printer-ink/10" role="list">
			{page.data.map((note) => (
				<li class="py-2">
					<Note note={note} as="h2" isPreview />
				</li>
			))}
		</ul>
	)}
	<Pagination page={page} />
</PageLayout>
