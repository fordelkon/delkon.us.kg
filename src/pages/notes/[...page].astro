---
import { type CollectionEntry, render } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import SeriesArchive from "@/components/SeriesArchive.astro";
import { getPublishedNotes } from "@/data/entries";
import { getSeriesGroups, type SeriesGroup } from "@/data/series";
import PageLayout from "@/layouts/Base.astro";
import { contentStyles } from "@/styles/content-styles";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_NOTES_PER_PAGE = 10;
	const publishedNotes = await getPublishedNotes();

	// Folders scoped to notes: only series with note members become folders.
	const seriesGroups = await getSeriesGroups("note");

	return paginate(publishedNotes, {
		pageSize: MAX_NOTES_PER_PAGE,
		props: { seriesGroups },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
	seriesGroups: SeriesGroup[];
}

const { page, seriesGroups } = Astro.props;
const notes = await Promise.all(page.data.map(async (note) => ({ note, ...(await render(note)) })));

const stylesheets = contentStyles(
	...notes.map(({ remarkPluginFrontmatter }) => remarkPluginFrontmatter),
);

const meta = {
	description: "Read my collection of notes",
	title: "Notes",
};
---

<PageLayout meta={meta} stylesheets={stylesheets}>
	<header class="mb-(--receipt-page-heading-gap) flex items-center gap-3">
		<h1 class="receipt-title">Notes</h1>
		<a class="text-printer-accent hover:text-printer-ink" href="/notes/rss.xml" target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:rss" />
		</a>
	</header>
	{page.currentPage === 1 && <SeriesArchive groups={seriesGroups} />}
	{notes.length > 0 && (
		<ul class="divide-y divide-dotted divide-printer-ink/10" role="list">
			{notes.map(({ note, Content }) => (
				<li>
					<Note note={note} as="h2" isPreview>
						<Content />
					</Note>
				</li>
			))}
		</ul>
	)}
	<Pagination page={page} />
</PageLayout>
