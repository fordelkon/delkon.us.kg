---
import { getCollection } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Note from "@/components/note/Note.astro";
import SeriesNav from "@/components/SeriesNav.astro";
import { getSeriesContext } from "@/data/series";
import PageLayout from "@/layouts/Base.astro";
import { getFormattedDate } from "@/utils/date";

// if you're using an adaptor in SSR mode, getStaticPaths wont work -> https://docs.astro.build/en/guides/routing/#modifying-the-slug-example-for-ssr
export const getStaticPaths = (async () => {
	const allNotes = await getCollection("note");

	return allNotes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}) satisfies GetStaticPaths;

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note } = Astro.props;
const series = await getSeriesContext(note);

const meta = {
	description:
		note.data.description ||
		`Read about my note posted on: ${getFormattedDate(note.data.publishDate)}`,
	title: note.data.title,
};
---

<PageLayout meta={meta}>
	<Note as="h1" note={note} series={series} />
	<SeriesNav entry={note} />
</PageLayout>
