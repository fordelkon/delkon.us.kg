---
import { getPublishedPosts } from "@/data/entries";
import { getUniqueTagsWithCount } from "@/data/post";
import { tagUrl } from "@/data/routes";
import PageLayout from "@/layouts/Base.astro";

const allTags = getUniqueTagsWithCount(await getPublishedPosts());

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<header class="mb-6">
		<h1 class="font-serif text-2xl font-bold tracking-tight sm:text-3xl">Tags</h1>
	</header>
	<ul role="list">
		{
			allTags.map(([tag, val]) => (
				<li class="group flex items-baseline justify-between gap-4 border-b border-dotted border-printer-ink/10 py-3">
					<a
						class="font-serif text-base transition-colors group-hover:text-printer-accent focus-visible:text-printer-accent"
						href={tagUrl(tag)}
						title={`View posts with the tag: ${tag}`}
					>
						<span aria-hidden="true" class="me-0.5 font-mono text-xs text-printer-ink-light">#</span>
						{tag}
					</a>
					<span class="print-label text-printer-ink-light tabular-nums">
						{val} {val > 1 ? "posts" : "post"}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>
