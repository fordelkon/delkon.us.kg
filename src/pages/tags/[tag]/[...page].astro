---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getPublishedPosts } from "@/data/entries";
import { getTagMeta, getUniqueTags, MAX_POSTS_PER_PAGE } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) => {
	// Tags are topic filters: series members stay in tag listings (docs/writing.md).
	const sortedPosts = await getPublishedPosts();
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));

		return paginate(postsWithTag, {
			pageSize: MAX_POSTS_PER_PAGE,
			params: { tag },
		});
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);

const TagContent = tagMeta ? (await render(tagMeta)).Content : null;

const meta = {
	description: tagMeta?.data.description ?? `View all posts with the tag - ${tag}`,
	title: tagMeta?.data.title ?? `Posts about ${tag}`,
};
---

<PageLayout meta={meta}>
	<nav aria-label="Breadcrumbs" class="mb-6 print-label">
		<ul class="flex items-center gap-1.5">
			<li>
				<a class="text-printer-ink-light transition-colors hover:text-printer-accent" href="/tags/">
					Tags
				</a>
			</li>
			<li aria-hidden="true" class="text-printer-ink-light">/</li>
			<li aria-current="page" class="text-printer-ink">
				<span aria-hidden="true">#</span>
				{tag}
			</li>
		</ul>
	</nav>
	<h1 class="receipt-title capitalize">
		{tagMeta?.data.title ?? `Posts about ${tag}`}
	</h1>
	{
		tagMeta?.data.description && (
			<p class="mt-2 max-w-prose font-serif text-sm leading-relaxed text-printer-ink/80">
				{tagMeta.data.description}
			</p>
		)
	}
	{TagContent && <div class="prose prose-sm mt-4 max-w-none font-serif"><TagContent /></div>}
	<ul class="mt-8 divide-y divide-dotted divide-printer-ink/10" role="list">
		{
			page.data.map((p) => (
				<li class="py-2">
					<PostPreview as="h2" post={p} />
				</li>
			))
		}
	</ul>
	<Pagination page={page} labels={{ next: "Next Tags →", prev: "← Previous Tags" }} />
</PageLayout>
