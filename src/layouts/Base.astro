---
import { ClientRouter } from "astro:transitions";
import katexStyles from "katex/dist/katex.min.css?url";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import DeskStickers from "@/components/printed/DeskStickers.astro";
import PaperViewport from "@/components/printed/PaperViewport.astro";
import SkipLink from "@/components/SkipLink.astro";
import TableOverflow from "@/components/TableOverflow.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	hasMath?: boolean | undefined;
	showDeskStickers?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	hasMath = false,
	showDeskStickers = true,
} = Astro.props;

const hasStartGutter = Astro.slots.has("start-gutter");
const hasGutter = Astro.slots.has("gutter");
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		{hasMath && <link rel="stylesheet" href={katexStyles} />}
		<ThemeProvider />
		<ClientRouter />
	</head>
	<body class="font-mono text-printer-ink antialiased">
		<SkipLink />
		<!-- Desk and housing chrome stay here; the paper mechanics (sheet,
		     perforations, feed animation, paperFed script) live in
		     PaperViewport.astro. The desk's constant px-3 is the desk margin —
		     the paper's responsive inset is the --paper-inset token (see
		     printer-housing.css), consumed by PaperViewport's margin and
		     Header's feed slit. -->
		<div class="page-grid flex min-h-screen flex-col items-center px-3 py-6 sm:py-10">
			<div class="relative w-full max-w-3xl">
				<!-- Keep the housing above the sheet as it retracts into the slot. -->
				<div class="printer-sticky sticky z-30">
					<!-- Opaque desk behind the rounded housing masks paper during native
					     scrolling. Sized to the housing: the desk behind it shows the same
					     viewport-fixed texture, so a wider backdrop only adds horizontal
					     overflow on narrow viewports. -->
					<div
						aria-hidden="true"
						class="page-grid pointer-events-none absolute inset-x-0 top-0 bottom-3"
					></div>
					<Header />
				</div>
				<PaperViewport>
					<slot />
				</PaperViewport>
				{
					hasStartGutter && (
						<div class="pointer-events-none absolute inset-y-0 end-full hidden xl:block">
							<div class="article-gutter flex w-48 flex-col pe-8">
								<slot name="start-gutter" />
							</div>
						</div>
					)
				}
				{
					/* Page-margin gutter: sticky content anchored outside the paper's
					   end edge on wide screens, so it never squeezes the printed page.
					   The slot owner handles its own scrolling within the viewport. */
					hasGutter && (
						<div class="pointer-events-none absolute inset-y-0 start-full hidden xl:block">
							<div class="article-gutter flex w-48 flex-col ps-8">
								<slot name="gutter" />
							</div>
						</div>
					)
				}
			</div>
		</div>
		<TableOverflow />
		{showDeskStickers && <DeskStickers />}
		<slot name="floating-controls" />
		{import.meta.env.PROD && <pagefind-modal instance="site-search" />}
	</body>
</html>

<style>
	.article-gutter {
		--gutter-top: clamp(1rem, calc(100dvh - 24rem), 12rem);
		position: sticky;
		inset-block-start: var(--gutter-top);
		block-size: calc(100dvh - var(--gutter-top) - 4rem);
	}
</style>
