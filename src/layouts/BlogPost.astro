---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<article class="grow break-words" data-pagefind-body>
		<div id="blog-hero" class="mb-12">
			<Masthead content={post} readingTime={readingTime} />
		</div>
		{/* The TOC only ever renders in Base.astro's page-margin gutter (xl+),
		    outside the paper. An in-paper sticky column is not possible: the
		    sheet's overflow-hidden (paper-feed animation clipping) breaks
		    position: sticky, and a static column would squeeze the printed
		    page. Below xl the prose simply takes the full paper width. */}
		<div class="prose prose-sm min-w-0 max-w-none font-serif sm:prose-base [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto">
			<slot />
			<WebMentions />
		</div>
	</article>
	{!!headings.length && (
		<Fragment slot="gutter">
			<TOC headings={headings} />
		</Fragment>
	)}
	<button
		slot="floating-controls"
		class="fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border border-printer-ink/10 bg-printer-paper text-printer-ink opacity-0 shadow-(--paper-shadow-soft) transition-all transition-discrete duration-300 hover:border-printer-accent/30 hover:text-printer-accent focus-visible:border-printer-accent/30 focus-visible:text-printer-accent motion-reduce:transition-none data-[show=true]:visible data-[show=true]:translate-y-0 data-[show=true]:opacity-100 data-[show=false]:invisible sm:end-8 sm:h-12 sm:w-12"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	// Under the ClientRouter this module runs once per session, but each
	// navigation swaps in fresh DOM. Re-bind on every astro:page-load
	// (it also fires for the initial load).
	let observer: IntersectionObserver | null = null;

	function initToTop() {
		// SAFETY: These ids are rendered by this layout whenever the button is present.
		const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement | null;
		const targetHeader = document.getElementById("blog-hero");

		// Navigating away from a post swaps in a page without them.
		observer?.disconnect();

		observer = null;

		if (!scrollBtn || !targetHeader) return;

		const button = scrollBtn;

		function callback(entries: IntersectionObserverEntry[]) {
			entries.forEach((entry) => {
				// only show the scroll to top button when the heading is out of view
				button.dataset.show = (!entry.isIntersecting).toString();
			});
		}

		// Respect the user's reduced-motion preference when scrolling back to the top.
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		scrollBtn.addEventListener("click", () => {
			document.documentElement.scrollTo({
				behavior: prefersReducedMotion ? "instant" : "smooth",
				top: 0,
			});
		});

		observer = new IntersectionObserver(callback);
		observer.observe(targetHeader);
	}

	initToTop();

	document.addEventListener("astro:page-load", initToTop);
</script>
